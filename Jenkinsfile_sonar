
pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    environment {
        // DockerHub
        DOCKERHUB_REPO = 'laxmikanth5/reactjs-springboot'

        // AWS ECR
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '658424926696'
        ECR_REPO = 'devops25/backend-java'
        ECR_REGISTRY = '658424926696.dkr.ecr.us-east-1.amazonaws.com'
    }

    stages {

        // 1. SonarQube Code Analysis
        stage('SonarQube Code Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        mvn clean verify \
                            org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.projectKey=springboot-backend \
                            -Dsonar.projectName=springboot-backend
                    '''
                }
            }
        }

        // 2. SonarQube Quality Gate
        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // 3. Docker Image Build
        stage('Docker Image Build') {
            steps {
                sh '''
                    docker build \
                        -t java-spring:v${BUILD_NUMBER} \
                        -f Dockerfile_multi_stage \
                        .
                '''
            }
        }

        // 4. DockerHub Login
        stage('DockerHub Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker_cred_token',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        set +x
                        echo "$DOCKER_PASS" | docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin
                    '''
                }
            }
        }

        // 5. DockerHub Tagging
        stage('DockerHub Tagging') {
            steps {
                sh '''
                    docker tag \
                        java-spring:v${BUILD_NUMBER} \
                        ${DOCKERHUB_REPO}:spring-v${BUILD_NUMBER}
                '''
            }
        }

        // 6. Push Image to DockerHub
        stage('Push Image to DockerHub') {
            steps {
                sh '''
                    docker push \
                        ${DOCKERHUB_REPO}:spring-v${BUILD_NUMBER}
                '''
            }
        }

        // 7. AWS ECR Login + Tagging + Push
        stage('Push Image to AWS ECR') {
            steps {
                sh '''
                    # ECR Login
                    aws ecr get-login-password \
                        --region ${AWS_REGION} |
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}

                    # ECR Image Tagging
                    docker tag \
                        java-spring:v${BUILD_NUMBER} \
                        ${ECR_REGISTRY}/${ECR_REPO}:spring-v${BUILD_NUMBER}

                    # Push Image to ECR
                    docker push \
                        ${ECR_REGISTRY}/${ECR_REPO}:spring-v${BUILD_NUMBER}
                '''
            }
        }
    }

    post {

        always {
            slackSend(
                channel: '#all-project25',
                message: """
                    Job: ${env.JOB_NAME}
                    Build: #${env.BUILD_NUMBER}
                    Status: ${currentBuild.currentResult}
                    URL: ${env.BUILD_URL}
                """,
                teamDomain: 'project25-world',
                tokenCredentialId: 'slack-token'
            )
        }

        cleanup {
            cleanWs()
        }
    }
}
