
pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    tools {
        maven 'maven'
    }

    stages {

        stage('Maven Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Image Build') {
            steps {
                sh 'docker build -t java-spring:v${BUILD_NUMBER} .'
            }
        }

        stage('Docker Login') {
            steps {
                sh 'docker login'
            }
        }

        stage('Docker Tagging') {
            steps {
                sh 'docker tag java-spring:v${BUILD_NUMBER} laxmikanth5/reactjs-springboot:spring-v${BUILD_NUMBER}'
            }
        }

        stage('Image Push to DockerHub') {
            steps {
                sh 'docker push laxmikanth5/reactjs-springboot:spring-v${BUILD_NUMBER}'
            }
        }

        /*
